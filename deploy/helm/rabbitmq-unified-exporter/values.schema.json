{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "priorityClassName": {
      "type": "string"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          },
          "additionalProperties": true
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "honorTimestamps": { "type": "boolean" },
        "honorLabels": { "type": "boolean" },
        "scrapeClass": { "type": "string" },
        "fallbackScrapeProtocol": { "type": "string" },
        "metricRelabelings": { "type": "array" },
        "relabelings": { "type": "array" },
        "sampleLimit": { "type": ["integer", "null"] },
        "labelLimit": { "type": ["integer", "null"] },
        "tlsConfig": { "type": "object" },
        "basicAuth": { "type": "object" }
      },
      "additionalProperties": true
    },
    "vmServiceScrape": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "honorTimestamps": { "type": "boolean" },
        "honorLabels": { "type": "boolean" },
        "scrapeClass": { "type": "string" },
        "fallbackScrapeProtocol": { "type": "string" },
        "metricRelabelings": { "type": "array" },
        "relabelings": { "type": "array" },
        "sampleLimit": { "type": ["integer", "null"] },
        "labelLimit": { "type": ["integer", "null"] },
        "tlsConfig": { "type": "object" },
        "basicAuth": { "type": "object" }
      },
      "additionalProperties": true
    },
    "scrapeConfig": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "honorTimestamps": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" }
      },
      "additionalProperties": true
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "brokerCIDRs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "brokerPorts": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "ingressFrom": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
